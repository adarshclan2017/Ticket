{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://148.72.215.143:155/$1"
    },
    {
      "source": "/inpack-api/(.*)",
      "destination": "http://148.72.215.143:1355/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
